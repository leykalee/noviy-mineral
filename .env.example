# ─────────────────────────────────────────────────────────────
# Новый Минерал — витрина (headless-потребитель Storefront API Admik)
# Скопируйте в .env.local и заполните. Своей БД у витрины нет:
# каталог/заказы/доставка/оплата — на стороне Admik.
# ─────────────────────────────────────────────────────────────

# Публичный адрес витрины. Влияет на canonical, OpenGraph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Подключение к Admik (Storefront API) ────────────────────
# Серверные запросы витрины к API (server components / route handlers).
# В docker-стенде — ВНУТРЬ сети: http://app:3000. Локально — адрес Admik.
ADMIK_API_URL=http://localhost:3000

# Публичный адрес API для клиентского бандла (checkout, автокомплит городов).
# В проде — публичный адрес Admik (напр. https://admin.<домен>).
NEXT_PUBLIC_ADMIK_API_URL=http://localhost:3000

# Ключ витрины (если Admik настроен на STOREFRONT_API_KEYS). Пусто — доступ по
# Origin-allowlist / mock. ТОЛЬКО серверная переменная (в бандл не попадает).
STOREFRONT_API_KEY=

# ─── SEO ─────────────────────────────────────────────────────
# 1/true — закрыть витрину от индексации (staging). Пусто — боевой магазин.
STOREFRONT_NOINDEX=
