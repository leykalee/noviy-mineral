# ─────────────────────────────────────────────────────────────
# Новый Минерал — переменные окружения
# Скопируйте в .env.local и заполните. Ключи только на сервере,
# во frontend-бандл ничего из этого не попадает.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта. Влияет на canonical, OpenGraph, sitemap и robots.
# Можно не задавать: адрес подхватится у площадки (Vercel, Netlify),
# а локально по умолчанию http://localhost:3000. Задавайте, когда нужен
# конкретный домен — например свой, а не служебный поддомен хостинга.
NEXT_PUBLIC_SITE_URL=

# ─── База данных ─────────────────────────────────────────────
# Пока не задана, магазин работает на demo-каталоге из src/data/demo.
# Схема таблиц: src/db/schema.ts (Drizzle). Миграции: npm run db:generate && npm run db:push
DATABASE_URL=

# ─── Доставка: СДЭК ──────────────────────────────────────────
# Если обе переменные заданы — включается боевой провайдер CdekDeliveryProvider,
# иначе работает DemoDeliveryProvider с тестовыми тарифами.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Тестовый контур: https://api.edu.cdek.ru/v2
CDEK_API_BASE=https://api.cdek.ru/v2

# ─── Оплата: CDEK PAY ────────────────────────────────────────
# Обе переменные заданы — включается CdekPayProvider, иначе DemoPaymentProvider
# (платежи не проводятся, заказ остаётся в статусе «ожидает оплаты»).
CDEK_PAY_MERCHANT_ID=
CDEK_PAY_SECRET_KEY=
CDEK_PAY_API_BASE=https://api.cdekpay.ru

# ─── Почтовые уведомления ────────────────────────────────────
# Все три заданы — письма уходят через ApiEmailProvider,
# иначе DevEmailProvider только пишет в лог сервера.
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM=

# ─── Новости из сообщества ВКонтакте ─────────────────────────
# Токен ПОЛЬЗОВАТЕЛЬСКИЙ либо сервисный ключ приложения: методу wall.get
# недоступна авторизация от имени сообщества (VK отвечает ошибкой 27).
# Без него раздел «Новости» показывает ссылку на сообщество.
VK_TOKEN=
